# ⚠️ 보안 주의: VITE_ 접두사가 붙은 값은 모두 브라우저 번들에 그대로 노출됩니다.
#   → 공개되어도 되는 키(anon key, publishable key)만 VITE_ 로 둘 것.
#   → service role key / stripe secret / webhook secret 은 절대 VITE_ 로 두지 말 것.
#     (이들은 Supabase Edge Function 환경변수에만 설정 — 아래 server-side 섹션 참고)

VITE_SUPABASE_URL=https://your-project.supabase.co
# anon key 는 공개 키입니다. 실제 데이터 보호는 RLS 정책으로 이루어집니다.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe publishable key (pk_...) — 공개되어도 안전
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# 개인 업체 플랜 Price ID (Stripe Dashboard > Products)
VITE_STRIPE_PRICE_IND_MONTHLY=price_...
VITE_STRIPE_PRICE_IND_ANNUAL=price_...

# 전문가 플랜 Price ID
VITE_STRIPE_PRICE_AGY_MONTHLY=price_...
VITE_STRIPE_PRICE_AGY_ANNUAL=price_...

# Server-side only (Supabase Edge Function 환경변수로 설정)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
